# 复制成 .env.local 再填。
# 不配任何变量也能跑起来 —— 页面会退回示例数据并明确标注。

# Postgres 连接串。Neon / Supabase 控制台都能直接复制。
# 配了它，探测数据、故障事件、用户上报就都是真的了。
DATABASE_URL=

# 本地 Postgres 没有 SSL 时设成 disable
# DATABASE_SSL=disable

# 探测脚本回传结果时的鉴权口令，随便生成一串长随机字符串。
# 这个接口会写库，务必设置。
INGEST_SECRET=

# 下面是给探测脚本 / GitHub Actions 用的，不需要写进 Vercel：
# ANYROUTER_KEY=sk-你的探测用key
# INGEST_URL=https://你的域名/api/ingest
# PROBE_TIMEOUT_MS=15000
